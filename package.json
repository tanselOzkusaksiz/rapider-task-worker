{
  "name": "rapider-task-worker",
  "version": "1.1.0",
  "description": "Isolated Multi-Repo AI Task Orchestrator, Single-Workspace Worker & Standalone Admin Task Management UI for Rapider WorkItems (kind='task').",
  "private": true,
  "scripts": {
    "orchestrator": "node scripts/isolated-task-orchestrator.js",
    "orchestrator:once": "node scripts/isolated-task-orchestrator.js --once",
    "orchestrator:offline": "node scripts/isolated-task-orchestrator.js --offline",
    "orchestrator:once:offline": "node scripts/isolated-task-orchestrator.js --once --offline",
    "ui": "node management-ui/server.js",
    "ctl": "node scripts/rapider-task-ctl.js",
    "ctl:status": "node scripts/rapider-task-ctl.js status",
    "ctl:history": "node scripts/rapider-task-ctl.js history",
    "ctl:pause": "node scripts/rapider-task-ctl.js pause",
    "ctl:hard-pause": "node scripts/rapider-task-ctl.js hard-pause",
    "ctl:resume": "node scripts/rapider-task-ctl.js resume",
    "ctl:concurrency": "node scripts/rapider-task-ctl.js set-concurrency",
    "ctl:pin-top": "node scripts/rapider-task-ctl.js pin-top",
    "ctl:kill-task": "node scripts/rapider-task-ctl.js kill-task",
    "ctl:requeue-top": "node scripts/rapider-task-ctl.js requeue-top",
    "ctl:logs": "node scripts/rapider-task-ctl.js logs",
    "ctl:cache-status": "node scripts/rapider-task-ctl.js cache-status",
    "fetch-tasks": "node scripts/fetch-and-validate-tasks.js --limit=5",
    "fetch-tasks:all": "node scripts/fetch-and-validate-tasks.js --all",
    "worker": "node scripts/task-worker-daemon.js",
    "worker:1m": "node scripts/task-worker-daemon.js --interval=1m",
    "worker:once": "node scripts/task-worker-daemon.js --once",
    "worker:headless": "node scripts/task-worker-daemon.js --headless",
    "prepare:workspace": "node scripts/prepare-workspace-repo.js",
    "prepare:models": "node scripts/prepare-workspace-repo.js --step=models",
    "prepare:datasources": "node scripts/prepare-workspace-repo.js --step=datasources",
    "prepare:notebooks": "node scripts/prepare-workspace-repo.js --step=notebooks",
    "prepare:envs": "node scripts/prepare-workspace-repo.js --step=envs",
    "status": "node scripts/manage-workspace-repos.js --status",
    "activate": "node scripts/manage-workspace-repos.js",
    "park:all": "node scripts/manage-workspace-repos.js --park-all",
    "workspace:tools": "node scripts/workspace-tools-cli.js",
    "upload-artifact": "node scripts/upload-task-artifacts.js",
    "patch-task": "node scripts/patch-workitem-task.js",
    "logs:sync": "node scripts/generate-iteration-logs.js",
    "test": "node --test tests/*.test.js",
    "test:orchestrator": "node --test tests/isolated-orchestrator.test.js",
    "test:prepare": "node --test tests/workspace-repo-preparation.test.js",
    "ubuntu:setup": "bash deploy/ubuntu-setup.sh"
  },
  "dependencies": {
    "handlebars": "^4.7.8"
  },
  "keywords": [
    "rapider",
    "task-worker",
    "task-orchestrator",
    "workitems",
    "isolated-sandbox",
    "management-ui",
    "automation"
  ],
  "author": "Rapider AI",
  "license": "UNLICENSED"
}
