# Rapider Task Worker Environment Configuration Template
# Copy to .env (gitignored) and populate dynamically at runtime.
# NEVER commit real credentials, tokens, or project IDs to git.

RAPIDER_API_URL=https://dev.api.rappider.com
RAPIDER_WORKER_EMAIL=
RAPIDER_WORKER_PASSWORD=
# Optional service token alternative:
RAPIDER_SERVICE_TOKEN=

# FIFO Batch-of-5 Scheduling Settings (status='open', kind='task')
TASK_WORKER_BATCH_SIZE=5
TASK_WORKER_ELIGIBLE_STATUSES=open,Open
TASK_WORKER_MAX_BATCHES_PER_RUN=10
TASK_WORKER_POLL_INTERVAL=5m
STALE_RUNNING_LEASE_MS=900000
